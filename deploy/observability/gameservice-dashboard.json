{
  "title": "GameService Control API SLO",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Control API availability",
      "datasource": { "type": "prometheus", "uid": "gameservice-prometheus" },
      "targets": [{ "expr": "sum(gameservice_control_api_up)", "legendFormat": "up" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": { "type": "prometheus", "uid": "gameservice-prometheus" },
      "targets": [{ "expr": "sum(rate(gameservice_http_requests_total[5m]))", "legendFormat": "requests/s" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "datasource": { "type": "prometheus", "uid": "gameservice-prometheus" },
      "targets": [{ "expr": "sum(rate(gameservice_http_errors_total[5m])) / clamp_min(sum(rate(gameservice_http_requests_total[5m])), 1)", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process uptime",
      "datasource": { "type": "prometheus", "uid": "gameservice-prometheus" },
      "targets": [{ "expr": "max(gameservice_process_uptime_seconds)", "legendFormat": "seconds" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "datasource": { "type": "prometheus", "uid": "gameservice-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(gameservice_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 seconds" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.25 }] } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    }
  ]
}
